# Variables de Entorno para Drones RBG
# Copiar este archivo a .env y configurar las credenciales correspondientes

DEBUG=True
SECRET_KEY=django-insecure-tu-clave-secreta-aqui-cambiar-en-produccion

# URI de Conexión a MongoDB (Soporta Atlas y Local)
# Ejemplo Atlas: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/drones_rbg?retryWrites=true&w=majority
# Ejemplo Local: mongodb://localhost:27017/drones_rbg
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/drones_rbg?retryWrites=true&w=majority
MONGO_DB_NAME=drones_rbg
